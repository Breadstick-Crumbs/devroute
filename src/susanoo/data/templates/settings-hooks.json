{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [{"type": "command", "command": "susanoo hook pre-tool-use", "timeout": 30}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "susanoo hook stop", "timeout": 30}]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{"type": "command", "command": "susanoo hook session-start", "timeout": 30}]
      }
    ]
  },
  "auto_hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "susanoo hook user-prompt-submit", "timeout": 20}]
      }
    ]
  }
}
